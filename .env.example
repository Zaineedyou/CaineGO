# =============================================
# CAINE DISCORD BOT — CONFIGURATION
# Copy this file to .env and fill in the values
# =============================================

# REQUIRED: Discord bot token
# Get it from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# REQUIRED: Groq API key for AI
# Get it free from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# OPTIONAL: Bot command prefix (default: Caine)
BOT_PREFIX=Caine

# OPTIONAL: Default AI persona for all servers
# Leave empty to use the built-in default persona
SYSTEM_PROMPT=

# OPTIONAL: Your Discord user ID
# Grants you access to the bot dashboard on any server, even without admin role
BOT_OWNER_ID=

# OPTIONAL: SQLite database path (default: ./caine.db)
# Useful for Docker deployments — set to /app/data/caine.db
DB_PATH=

# OPTIONAL: Default conversation history limit per channel (default: 30, range: 5-100)
# Can also be overridden per server via dashboard or: Caine sethistory <number>
MAX_HISTORY=30

# OPTIONAL: AI rate limiting — max requests per user per time window
AI_RATE_MAX=10
AI_RATE_WINDOW_SEC=60
