# ==========================================
# WAJIB DIISI
# ==========================================

# Token bot Discord kamu
# Ambil di: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# API Key Groq untuk AI
# Ambil di: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# OPSIONAL
# ==========================================

# Prefix bot (default: Caine)
BOT_PREFIX=Caine

# System prompt / persona bot
# Kosongkan untuk pakai default
SYSTEM_PROMPT=
