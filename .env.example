# CaineGO configuration — copy to .env and replace the sample credentials.

# Required: Discord bot token and Groq API key
DISCORD_TOKEN=your_discord_bot_token_here
GROQ_API_KEY=your_groq_api_key_here

# Required for running the bot directly on this host.
# For Docker Compose, the app service overrides the hostname to `db`.
DATABASE_URL=postgres://caine:change-me@localhost:5432/caine?sslmode=disable

# PostgreSQL service settings for Docker Compose.
# Change the sample password before deploying; Compose uses it for both the DB and app URL.
POSTGRES_USER=caine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caine

# Optional bot settings
BOT_PREFIX=Caine
SYSTEM_PROMPT=
BOT_OWNER_ID=
MAX_HISTORY=30
AI_RATE_MAX=10
AI_RATE_WINDOW_SEC=60

# Optional Minecraft bridge settings
BRIDGE_TOKEN=
BRIDGE_PORT=8080
